# --- Delivery pipeline ---------------------------------------------------
# The targets are created below rather than by the module: the module cannot
# name the identity a target deploys as.
module "delivery-inventory-replica" {
  source      = "../../../modules/cloud-deploy"
  project_id  = local.project_app_core_0
  region      = "europe-west4"
  name        = "inventory-replica"
  description = "Promotes inventory-replica through prd"

  targets = [
    {
      name          = "inventory-replica-prd"
      create_target = false
    },
  ]

  labels = {
    application = "inventory-replica"
    managed-by  = "merlin"
  }
