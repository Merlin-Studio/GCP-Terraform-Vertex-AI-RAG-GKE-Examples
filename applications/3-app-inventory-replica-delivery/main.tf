# target it uses the Compute Engine default service account of this project,
# which nobody chose and which holds whatever that project granted it.
module "sa-inventory-replica-deploy" {
  source      = "../../../modules/iam-service-account"
  project_id  = local.project_app_core_0
  name        = "inventory-replica-deploy"
  description = "Cloud Deploy runs inventory-replica's releases as this"
  iam_project_roles = {
    (local.project_app_core_0) = [
      "roles/clouddeploy.jobRunner",
    ]
  }
