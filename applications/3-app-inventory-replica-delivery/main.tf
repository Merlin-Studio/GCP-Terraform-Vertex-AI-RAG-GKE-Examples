resource "google_clouddeploy_target" "inventory_replica_prd" {
  project          = local.project_app_core_0
  location         = "europe-west4"
  name             = "inventory-replica-prd"
  description      = "inventory-replica in prd"
  # Production: a person looks before this lands.
  require_approval = true

  execution_configs {
    usages          = ["RENDER", "DEPLOY"]
    service_account = module.sa-inventory-replica-deploy.email
    # The private pool on vpc-shared-prod, from 3-delivery-pools: inside a VPC
