  project      = local.project_seller_dp_dev_0
  region       = "europe-west4"
  display_name = "seller-assistant-vectors-dev"
  description  = "Retrieval corpus for seller-assistant"

  metadata {
    config {
      dimensions                  = 768
      approximate_neighbors_count = 150
      # Has to match what the embedding model was trained for, and cannot be
      # changed once the index is built.
      distance_measure_type = "COSINE_DISTANCE"
      algorithm_config {
        tree_ah_config {
          leaf_node_embedding_count    = 500
          leaf_nodes_to_search_percent = 7
        }
      }
    }
  }
  index_update_method = "STREAM_UPDATE"
  encryption_spec {
    kms_key_name = google_kms_crypto_key.app_seller_assistant_dev_europe_west4_vertexai.id
  }
}

resource "google_vertex_ai_index_endpoint" "seller-assistant-vectors-dev" {
  project      = local.project_seller_dp_dev_0
  region       = "europe-west4"
  display_name = "seller-assistant-vectors-dev"
  description  = "Private endpoint for seller-assistant-vectors-dev"

  # Reached from inside the VPC and from nowhere else. A public index
