# --- Model guardrail: seller-assistant-llm-dev -------------------------------------
# There is no model here. Gemini is reached at a regional API endpoint, and
# which model this application calls is a line in its own code -- it changes
# with the release cycle and does not belong pinned in Terraform.
#
# What this is, is the screening every prompt and every response should pass
# through -- and the honest word is "should". The application applies this
# template on each call; nothing in this stage can force it to, because the
# identity that calls the model is the same identity either way.
#
# What does force it is a Model Armor floor setting, which is set on the
# organisation or the folder and applies to every project underneath. That
# belongs to the landing zone rather than to one application, so Merlin does
# not write it here. If you need the guarantee rather than the intention,
# ask for it there.
resource "google_model_armor_template" "seller-assistant-llm-dev" {
  provider    = google-beta
  project     = local.project_seller_app_dev_0
  location    = "europe-west4"
  template_id = "seller-assistant-llm-dev"

  filter_config {
    # Personal data detected and de-identified before the model sees it.
    # This one is a control, not a preference: GDPR Article 25 and the HIPAA
    # Security Rule both name DLP scanning, and CONFORMANCE.md cites them.
    sdp_settings {
      basic_config {
        filter_enforcement = "ENABLED"
      }
    }
    # Injection and jailbreak screening. No framework in this landing zone
    # requires it: it is Merlin's opinion, and turning it off costs nothing
    # in the conformance record.
    pi_and_jailbreak_filter_settings {
      filter_enforcement = "ENABLED"
      confidence_level   = "MEDIUM_AND_ABOVE"
    }
    rai_settings {
      rai_filters {
        filter_type      = "DANGEROUS"
        confidence_level = "MEDIUM_AND_ABOVE"
      }
      rai_filters {
        filter_type      = "HATE_SPEECH"
        confidence_level = "MEDIUM_AND_ABOVE"
      }
      rai_filters {
        filter_type      = "HARASSMENT"
        confidence_level = "MEDIUM_AND_ABOVE"
      }
      rai_filters {
        filter_type      = "SEXUALLY_EXPLICIT"
        confidence_level = "MEDIUM_AND_ABOVE"
      }
    }
  }

  # What was asked and what was answered, kept for 30
  # days. It is an audit record and it is also a copy of whatever the prompt
  # contained, which is why it stays in this application's own project.
  template_metadata {
    log_sanitize_operations    = true
    log_template_operations    = true
  }
}

# --- Vector index: seller-assistant-vectors-dev -----------------------------------------
# Passages stored by meaning. The index is cheap to keep and the endpoint
# below is not: it is charged while it is deployed, asked or not.
